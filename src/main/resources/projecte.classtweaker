classTweaker v1 official

# Converted from META-INF/accesstransformer.cfg (NeoForge AT). Field descriptors verified against the 1.21.1 Mojmap jar,
# then re-validated against the 26.3 (unobfuscated, official names) jar during the 26.3 port.
#
# 26.3 removed several members these rules widened (validated with :validateAccessWidener); the source that used them
# was rewritten against the replacement APIs and the dead rules were dropped. See the "Removed in 26.3" notes below.

accessible field net/minecraft/resources/RegistryOps lookupProvider Lnet/minecraft/resources/RegistryOps$RegistryInfoLookup;

# PECore#dataPackSync: skip the EMC data sync for the integrated server host (NeoForge exposes this via getConnection().isMemoryConnection())
accessible field net/minecraft/server/network/ServerCommonPacketListenerImpl connection Lnet/minecraft/network/Connection;

accessible method net/minecraft/world/item/BlockItem getPlacementState (Lnet/minecraft/world/item/context/BlockPlaceContext;)Lnet/minecraft/world/level/block/state/BlockState;
accessible method net/minecraft/world/item/GameMasterBlockItem getPlacementState (Lnet/minecraft/world/item/context/BlockPlaceContext;)Lnet/minecraft/world/level/block/state/BlockState;
accessible method net/minecraft/world/item/StandingAndWallBlockItem getPlacementState (Lnet/minecraft/world/item/context/BlockPlaceContext;)Lnet/minecraft/world/level/block/state/BlockState;

accessible field net/minecraft/world/item/context/BlockPlaceContext replaceClicked Z

# Removed in 26.3: FireworkRocketRecipe#GUNPOWDER_INGREDIENT, FireworkStarRecipe#SHAPE_BY_ITEM/TRAIL_INGREDIENT/
# TWINKLE_INGREDIENT. The recipes became data driven: both now keep plain Ingredient fields (shell/fuel/star and
# shapes/trail/twinkle/fuel/dye) behind MAP_CODEC/STREAM_CODEC, so the custom EMC readouts go through the recipe
# registry instead of the (now gone) static maps. Those fields are private, so the ones still read are widened here.
accessible field net/minecraft/world/item/crafting/FireworkStarRecipe shapes Ljava/util/Map;
accessible field net/minecraft/world/item/crafting/FireworkStarRecipe trail Lnet/minecraft/world/item/crafting/Ingredient;
accessible field net/minecraft/world/item/crafting/FireworkStarRecipe twinkle Lnet/minecraft/world/item/crafting/Ingredient;
accessible field net/minecraft/world/item/crafting/FireworkRocketRecipe fuel Lnet/minecraft/world/item/crafting/Ingredient;

# SmithingTransformRecipe keeps 'base' non-optional; template/addition became Optional<Ingredient>, so only the
# still-present field stays widened (the Optional ones are read through templateIngredient()/additionIngredient()).
accessible field net/minecraft/world/item/crafting/SmithingTransformRecipe base Lnet/minecraft/world/item/crafting/Ingredient;
accessible field net/minecraft/world/item/crafting/SmithingTrimRecipe base Lnet/minecraft/world/item/crafting/Ingredient;
accessible field net/minecraft/world/item/crafting/SmithingTrimRecipe addition Lnet/minecraft/world/item/crafting/Ingredient;
accessible field net/minecraft/world/item/crafting/SmithingTrimRecipe template Lnet/minecraft/world/item/crafting/Ingredient;

# Removed in 26.3: PotionBrewing (the whole class is gone) together with its potionMixes/containerMixes/containers
# lists and the PotionBrewing$Mix record. Brewing is data driven through the recipe registry now, so BrewingMapper
# reads registered brewing recipes instead of reflecting into those lists.

accessible method net/minecraft/world/level/block/LeavesBlock decaying (Lnet/minecraft/world/level/block/state/BlockState;)Z

accessible field net/minecraft/world/level/block/GrowingPlantBlock growthDirection Lnet/minecraft/core/Direction;
accessible method net/minecraft/world/level/block/GrowingPlantBlock getBodyBlock ()Lnet/minecraft/world/level/block/Block;
accessible method net/minecraft/world/level/block/GrowingPlantBodyBlock getBodyBlock ()Lnet/minecraft/world/level/block/Block;
accessible method net/minecraft/world/level/block/CaveVinesBlock getBodyBlock ()Lnet/minecraft/world/level/block/Block;
accessible method net/minecraft/world/level/block/KelpBlock getBodyBlock ()Lnet/minecraft/world/level/block/Block;
accessible method net/minecraft/world/level/block/TwistingVinesBlock getBodyBlock ()Lnet/minecraft/world/level/block/Block;
accessible method net/minecraft/world/level/block/WeepingVinesBlock getBodyBlock ()Lnet/minecraft/world/level/block/Block;

accessible field net/minecraft/world/level/block/state/properties/IntegerProperty max I

accessible field net/minecraft/world/level/chunk/LevelChunk tickersInLevel Ljava/util/Map;
accessible method net/minecraft/world/level/chunk/LevelChunk isTicking (Lnet/minecraft/core/BlockPos;)Z
accessible class net/minecraft/world/level/chunk/LevelChunk$BoundTickingBlockEntity
accessible field net/minecraft/world/level/chunk/LevelChunk$BoundTickingBlockEntity ticker Lnet/minecraft/world/level/block/entity/BlockEntityTicker;
accessible class net/minecraft/world/level/chunk/LevelChunk$RebindableTickingBlockEntityWrapper
accessible field net/minecraft/world/level/chunk/LevelChunk$RebindableTickingBlockEntityWrapper ticker Lnet/minecraft/world/level/block/entity/TickingBlockEntity;

# Removed in 26.3: AxeItem#STRIPPABLES and ShovelItem#FLATTENABLES (both whole classes are gone). Tool conversion is
# data driven now through DataComponents#BLOCK_TRANSFORMER (a Holder<BlockTransformer>), which ToolHelper reads and
# which modded content extends by registering its own transformer entries.

accessible field net/minecraft/world/level/block/LiquidBlock fluid Lnet/minecraft/world/level/material/FlowingFluid;

accessible field net/minecraft/world/item/ItemStackLinkedSet TYPE_AND_TAG Lit/unimi/dsi/fastutil/Hash$Strategy;

# Removed in 26.3: BlockBehaviour#propertiesCodec(), together with the block_type registry and every Block#codec.
# PEBlockTypes (which only existed to forward the ProjectE block properties codec) was deleted along with the
# registration call in PECore.

# Philosopher's Stone: allow self-referencing as its own craftingRemainingItem. The field is private final and its
# type changed from Item to ItemStackTemplate in 26.3 (stacks can no longer be built without a level, so recipes
# carry templates instead).
accessible field net/minecraft/world/item/Item craftingRemainingItem Lnet/minecraft/world/item/ItemStackTemplate;
mutable field net/minecraft/world/item/Item craftingRemainingItem Lnet/minecraft/world/item/ItemStackTemplate;

# Nova Catalyst / Nova Cataclysm: EntityNovaPrimed overrides explode() to run the custom Nova
# explosion instead of the vanilla 4.0F one (NeoForge patches this method to protected).
# PrimedTnt#tick already invokes it virtually, so widening it is enough for the override to dispatch.
extendable method net/minecraft/world/entity/item/PrimedTnt explode ()V
